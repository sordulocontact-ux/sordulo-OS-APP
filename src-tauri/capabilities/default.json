{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits des fenêtres main et prompt : événements, fenêtre, positionnement près de la zone de notification.",
  "windows": ["main", "prompt"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "positioner:default"
  ]
}
