{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sordulo OS",
  "version": "../package.json",
  "identifier": "com.sordulo.os",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml --bin sordulo-hook && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sordulo OS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MzVGQjhENjM4MjQ3RTAKUldUZ1I0SmpqZnMxeUhuNXVqbVBUVVRVM0hwdk5hSC9xUnRiMjZoZkVRSi8xNXNZVkl4ZituZFQK",
      "endpoints": [
        "https://github.com/sordulocontact-ux/sordulo-OS-APP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
