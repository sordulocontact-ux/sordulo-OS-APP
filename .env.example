# --- Front (exposées au navigateur, préfixe VITE_) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Serveur uniquement (fonctions /api) — ne jamais préfixer par VITE_ ---
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Clé Deepgram (transcription française + séparation des voix)
TRANSCRIPTION_API_KEY=
# Adresse publique de l'app (optionnelle) : retour des liens de connexion générés par l'Équipe quand
# l'origine de la requête n'est pas reconnue. À déclarer aussi dans Supabase > Auth > Redirect URLs.
APP_URL=https://sordulo-os-app.vercel.app

# --- Scripts locaux uniquement (migrations + seed), pas sur Vercel ---
# Chaîne de connexion Postgres (Supabase > Project Settings > Database > Connection string, mode "Session")
SUPABASE_DB_URL=
SEED_MAEL_EMAIL=
SEED_SACHA_EMAIL=

# --- Repli IA gratuit si Claude est indisponible (serveur uniquement, optionnel) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- App bureau, build de production uniquement (en dev, Tauri charge http://localhost:5173) ---
# VITE_API_BASE_URL=https://<ton-projet>.vercel.app
